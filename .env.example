# =============================================================================
# Echo environment variables. Copy to .env (repo root) and apps/web/.env.local.
# Every secret is read from the environment; nothing is hard-coded.
# =============================================================================

# --- Database (Neon or Vercel Postgres, with the pgvector extension) ---------
# Use the pooled connection string on Vercel.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/echo

# --- LLM provider (classification, rewrite, image OCR fallback) --------------
# LLM_PROVIDER selects the implementation behind packages/core's LlmProvider.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL_CLASSIFY=claude-opus-5-5
LLM_MODEL_REWRITE=claude-opus-5-5
LLM_MODEL_VISION=claude-opus-5-5

# --- OpenAI (Whisper transcription + 1536-dim embeddings) --------------------
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
EMBEDDING_MODEL=text-embedding-3-small

# --- X API v2 (OAuth 2.0 PKCE, scopes: tweet.read users.read bookmark.read offline.access)
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Google AdMob (rewarded video for free users) ----------------------------
ADMOB_APP_ID=
ADMOB_REWARDED_UNIT_ID=

# --- RevenueCat (Echo Plus subscriptions) ------------------------------------
# Public Apple SDK key (appl_...), used by the iOS app.
REVENUECAT_API_KEY=
# Shared secret you set as the webhook Authorization header in RevenueCat.
REVENUECAT_WEBHOOK_SECRET=

# --- Auth.js -----------------------------------------------------------------
# openssl rand -base64 32. Also signs the iOS app's bearer tokens and encrypts OAuth tokens at rest.
AUTH_SECRET=
# Public URL of the site, e.g. https://getecho.ai (Vercel sets VERCEL_URL, but OAuth callbacks need the stable one).
AUTH_URL=http://localhost:3000
# Sign in with Apple (web: Services ID + generated client secret JWT).
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Bundle id the iOS app's Apple identity tokens are issued for.
APPLE_BUNDLE_ID=ai.getecho.app
# Email magic links go through any SMTP server you already have (no specific vendor required).
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM="Echo <hello@getecho.ai>"

# --- Vercel Blob (uploaded screenshots and videos) ---------------------------
BLOB_READ_WRITE_TOKEN=

# --- Background jobs ---------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/* routes.
CRON_SECRET=

# --- Product config ----------------------------------------------------------
FREE_SAVES_PER_MONTH=15

# --- iOS app (Expo reads EXPO_PUBLIC_* at build time) ------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=
